<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="JLModManager.App.MainWindow" Title="七日杀 Mod 管理器 0.3.3" Width="1180" Height="780" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,6">
      <Button Content="选择目录" Click="PathsClick" Margin="8,0,0,0" DockPanel.Dock="Right" />
      <TextBlock Text="游戏 Mods：" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="8,5">
        <TextBlock x:Name="GameLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
      </Border>
    </DockPanel>
    <TextBlock x:Name="DeployLabel" Grid.Row="1" Margin="0,0,0,10" Foreground="{StaticResource Muted}" FontSize="14" />
    <TabControl Grid.Row="2" x:Name="Tabs" SelectedIndex="0" BorderThickness="0,1,0,0" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" Padding="0,16,0,0">
      <TabItem Header="方案">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Padding="0" Margin="0,0,0,8" BorderThickness="0">
            <StackPanel>
              <WrapPanel>
                <ComboBox x:Name="Profiles" Width="260" SelectionChanged="ProfileChanged" Margin="0,0,12,8" />
                <Button Content="新建" Click="NewProfileClick" Style="{StaticResource Quiet}" />
                <Button Content="复制" Click="CloneProfileClick" Style="{StaticResource Quiet}" />
                <Button Content="重命名" Click="RenameProfileClick" Style="{StaticResource Quiet}" />
                <Button Content="删除" Click="DeleteProfileClick" Style="{StaticResource Quiet}" />
              </WrapPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                  <TextBlock Text="目标版本" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,0,0,5" />
                  <TextBox x:Name="VersionNote" TextChanged="NoteChanged" ToolTip="如 v3.3 b18；仅作备注，不自动切换游戏版本" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="方案备注" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,0,0,5" />
                  <TextBox x:Name="ProfileNotes" TextChanged="NoteChanged" ToolTip="记录玩法、服务器或使用说明" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock x:Name="CountLabel" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,18,8" />
            <WrapPanel HorizontalAlignment="Right">
              <Button Content="添加模组" Click="LibraryClick" />
              <Button Content="导入压缩包" Click="ImportZipClick" />
              <Button Content="导出整合包" Click="ExportPackClick" />
            </WrapPanel>
          </DockPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="246" />
            </Grid.ColumnDefinitions>
            <Border ClipToBounds="True" Padding="0" BorderThickness="0" Margin="0,0,0,8">
              <DataGrid x:Name="ModGrid" SelectionChanged="ModSelected">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="启用" Width="54">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="启用 / 禁用" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="模组" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                  <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="版本" Binding="{Binding Version}" Width="82" IsReadOnly="True" />
                  <DataGridTextColumn ElementStyle="{StaticResource StateText}" Header="部署" Binding="{Binding State}" Width="80" IsReadOnly="True" />
                  <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="类型" Binding="{Binding Kind}" Width="96" IsReadOnly="True" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <Border Grid.Column="1" Padding="18,2,0,0" Margin="16,0,0,8" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">

                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <TextBlock x:Name="DetailTitle" Text="选择一个模组" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailText" Text="" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,12,0,16" />
                    <WrapPanel><Button Content="详情" Click="DetailsClick" Style="{StaticResource Quiet}" /><Button Content="来源" Click="SourceClick" Style="{StaticResource Quiet}" /></WrapPanel>
                    <TextBlock Text="版本 / 分支" FontWeight="SemiBold" FontSize="14" />
                    <ComboBox x:Name="Versions" SelectionChanged="VersionChanged" Margin="0,8,0,14" />
                    <Button Content="打开目录" Click="OpenPackageClick" Margin="0,0,0,8" />
                    <Button Content="从方案移除" Click="RemoveClick" Margin="0" />
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="已安装模组">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="0" Margin="0,0,0,8" BorderThickness="0">
            <StackPanel>


              <WrapPanel>
                <Button Content="扫描已安装模组" Click="ScanClick" />
                <Button Content="接管选中项" Click="AdoptClick" />
                <Button Content="接管全部" Click="AdoptAllClick" />
                <Button Content="打开选中目录" Click="OpenInstalledClick" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Padding="0" BorderThickness="0" Margin="0,0,0,8">
            <DataGrid x:Name="InstalledGrid" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="模组" Binding="{Binding DisplayName}" Width="2*" />
                <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="版本" Binding="{Binding Version}" Width="80" />
                <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="状态" Binding="{Binding Status}" Width="160" />
                <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="所在目录" Binding="{Binding Path}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>
      <TabItem Header="下载与仓库">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <WrapPanel>
              <Button Content="选择下载目录" Click="ChooseDownloadsClick" />
              <Button Content="重新扫描" Click="ScanDownloadsClick" />
              <Button Content="导入压缩包" Click="ImportZipClick" />
              <Button Content="导入模组文件夹" Click="ImportFolderClick" />
            </WrapPanel>
            <TextBlock x:Name="DownloadLabel" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,14" />
          </StackPanel>
          <Border Grid.Row="1" Padding="0" Margin="0,0,0,8" BorderThickness="0">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top">
                <Button Content="导入选中项" Click="ImportDownloadClick" DockPanel.Dock="Right" />
                <TextBlock Text="下载内容" FontSize="14" FontWeight="SemiBold" />
              </DockPanel>
              <DataGrid x:Name="DownloadGrid" IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="名称" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="格式" Binding="{Binding Kind}" Width="100" />
                  <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="状态" Binding="{Binding Status}" Width="210" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
          <Border Grid.Row="2" Padding="0" BorderThickness="0" Margin="0,0,0,8">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top">
                <Button Content="加入当前方案" Click="AddCatalogClick" DockPanel.Dock="Right" />
                <TextBlock Text="已收录的模组" FontSize="14" FontWeight="SemiBold" />
              </DockPanel>
              <DataGrid x:Name="CatalogGrid" IsReadOnly="True">
                <DataGrid.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Items[0].Title}" FontWeight="SemiBold" Margin="6" /></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></DataGrid.GroupStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="模组" Binding="{Binding Title}" Width="*" />
                  <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="版本" Binding="{Binding VersionLabel}" Width="190" />
                  <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="分支" Binding="{Binding Branch}" Width="140" />
                  <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="选择" Binding="{Binding State}" Width="70" />
                  <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="作者" Binding="{Binding Author}" Width="120" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="备份 / 恢复">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Padding="0" Margin="0,0,0,8" BorderThickness="0">
              <StackPanel>
                <TextBlock Text="部署记录" FontSize="14" FontWeight="SemiBold" />

                <WrapPanel>
                  <Button Content="恢复未完成部署" Click="RecoverClick" />
                  <Button Content="回退上一次部署" Click="UndoClick" />
                  <Button Content="备份存档" Click="BackupClick" />
                  <Button Content="打开管理器数据" Click="OpenDataClick" />
                </WrapPanel>
                <TextBlock x:Name="HistoryText" TextWrapping="Wrap" Margin="0,16,0,0" />
              </StackPanel>
            </Border>
            <Border Padding="0" BorderThickness="0" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="联机清单" FontSize="14" FontWeight="SemiBold" />

                <WrapPanel>
                  <Button Content="导出清单" Click="ExportManifestClick" />
                  <Button Content="比较清单" Click="CompareClick" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Text="就绪" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="变更" Click="PlanClick" Style="{StaticResource Quiet}" Margin="0,0,8,0" />
          <Button Content="检查" Click="CheckClick" Style="{StaticResource Quiet}" Margin="0,0,8,0" />
          <Button Content="保存方案" Click="SaveProfileClick" Style="{StaticResource Quiet}" Margin="0,0,8,0" />
          <Button Content="仅应用" Click="ApplyClick" Margin="0,0,8,0" />
          <Button Content="启动方案" Click="LaunchClick" Style="{StaticResource Primary}" Margin="0" MinWidth="100" />
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="Busy" Background="#F2F3F6FA" Visibility="Collapsed" Grid.RowSpan="4">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="BusyText" FontSize="18" MaxWidth="540" TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="WorkBar" IsIndeterminate="True" Width="320" Height="8" Margin="0,20,0,0" Foreground="{StaticResource Accent}" />
        <TextBlock x:Name="WorkPercent" HorizontalAlignment="Center" FontSize="14" Margin="0,8,0,0" />
        <Button x:Name="CancelWork" Content="取消" Click="CancelClick" Margin="0,16,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
