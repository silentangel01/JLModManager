<Application x:Class="JLModManager.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#F3F6FA"/>
  <SolidColorBrush x:Key="Ink" Color="#243247"/>
  <SolidColorBrush x:Key="Accent" Color="#2D63A8"/>
  <SolidColorBrush x:Key="Line" Color="#D8E1EC"/>
  <SolidColorBrush x:Key="Muted" Color="#617187"/>
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Background" Value="{StaticResource Bg}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="UseLayoutRounding" Value="True"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,8,6"/><Setter Property="MinHeight" Value="34"/>
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#769BCB"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#2D63A8"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.72"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="10,6"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style TargetType="DataGrid">
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF1F7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowHeight" Value="38"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#FAFCFF"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
  </Style>
  <Style TargetType="DataGridRow">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EFF5FD"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E1ECFB"/><Setter Property="Foreground" Value="#214D83"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10,10"/><Setter Property="Background" Value="#EAF0F8"/><Setter Property="Foreground" Value="#52677F"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/></Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Padding" Value="10,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" BorderThickness="0"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#214D83"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="GridText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/></Style>
  <Style x:Key="StateText" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
   <Setter Property="Foreground" Value="#617187"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding State}" Value="已部署"><Setter Property="Foreground" Value="#2D63A8"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="待启用"><Setter Property="Foreground" Value="#94621E"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="待停用"><Setter Property="Foreground" Value="#94621E"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="待替换"><Setter Property="Foreground" Value="#94621E"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/></Style>
  <Style TargetType="TabItem">
   <Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinWidth" Value="88"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="Tab" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0,0,0,2"><ContentPresenter x:Name="HeaderLabel" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{StaticResource Muted}"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="HeaderLabel" Property="TextElement.Foreground" Value="{StaticResource Accent}"/><Setter TargetName="HeaderLabel" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="#E8F0FB"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="Background" Value="#DEEAFB"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
